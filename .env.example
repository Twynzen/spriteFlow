# ===================================================
# SpriteFlow - Environment Variables Configuration
# ===================================================
#
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env
#

# ===================================================
# RUNPOD API CONFIGURATION (Required for cloud usage)
# ===================================================
# Get your API key from: https://www.runpod.io/console/user/settings
# Find your Pod ID in: https://www.runpod.io/console/pods
#
# These are REQUIRED if you want to use the automated RunPod manager
# (runpod_manager.py and weekly_batch.sh)
#
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_POD_ID=your_pod_id_here

# ===================================================
# RUNPOD SSH CONFIGURATION (Required for weekly_batch.sh)
# ===================================================
# SSH connection details for your RunPod instance
# Format examples:
#   RUNPOD_HOST: abc123xyz.runpod.io or 123.45.67.89.tcp.runpod.net
#   RUNPOD_PORT: 22 or custom port (e.g., 12345)
#
RUNPOD_HOST=your_pod_host.tcp.runpod.net
RUNPOD_PORT=22

# ===================================================
# BATCH PROCESSING CONFIGURATION (Optional)
# ===================================================
# Default paths for batch processing
# Modify these if you want different directory structures
#
INPUT_DIR=./weekly_inputs
OUTPUT_DIR=./weekly_outputs
CONFIG_FILE=batch_config.json

# ===================================================
# MODEL CONFIGURATION (Optional - has defaults)
# ===================================================
# Paths to the AI models (relative to project root)
# You usually don't need to change these unless you have custom models
#
# RIFE_MODEL_PATH=Practical-RIFE/train_log/flownet.pkl
# REMBG_MODEL=u2net

# ===================================================
# CUDA CONFIGURATION (Optional - for advanced users)
# ===================================================
# GPU memory optimization settings
# Uncomment and modify if you experience CUDA out-of-memory errors
#
# PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
# CUDA_VISIBLE_DEVICES=0

# ===================================================
# NOTES:
# ===================================================
# 1. LOCAL USAGE (without RunPod):
#    - You DON'T need RUNPOD_* variables
#    - Just run: python src/process_sprites.py or src/batch_process.py
#
# 2. CLOUD USAGE (with RunPod):
#    - ALL RUNPOD_* variables are REQUIRED
#    - Get API key: https://www.runpod.io/console/user/settings
#    - Create a pod with GPU (RTX A4000 recommended)
#    - Use scripts/setup.sh on the pod to install everything
#
# 3. SECURITY:
#    - NEVER commit your .env file to git (.gitignore excludes it)
#    - Keep your RUNPOD_API_KEY secret
#
